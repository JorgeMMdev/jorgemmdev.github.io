---
import { site } from '../data/site';
---
<section id="contacto" aria-labelledby="contacto-titulo" class="mx-auto max-w-[1240px] px-6 pb-24">
  <a href={`mailto:${site.email}`} class="group block rounded-[32px] bg-primary px-8 py-14 text-bg md:px-12 md:py-16">
    <p class="font-mono text-sm">[Busco prácticas / mi primer empleo en IA…] Escríbeme:</p>
    <h2
      id="contacto-titulo"
      class="mt-3 flex flex-wrap items-center gap-6 font-display text-[clamp(3.5rem,9vw,6.5rem)] leading-[0.9] font-bold tracking-[-0.05em]"
    >
      ¿Hablamos?
      <svg
        class="size-[0.8em] transition-transform duration-300 group-hover:translate-x-2 group-hover:-translate-y-2"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <path d="M7 17L17 7M8 7h9v9" />
      </svg>
    </h2>
  </a>
</section>