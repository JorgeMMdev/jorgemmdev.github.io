---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-4 px-6 pb-10 font-mono text-[13px] text-ink-muted">
  <p>© {year} Jorge Muñoz Martínez</p>
  <ul class="flex gap-5">
    <li><a href={site.github} class="transition-colors hover:text-accent">GitHub</a></li>
    <li><a href={site.linkedin} class="transition-colors hover:text-accent">LinkedIn</a></li>
    <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">Email</a></li>
  </ul>
</footer>