---
import Layout from '../layouts/Layout.astro';
import SkillGraph from '../components/SkillGraph.astro';
import TechMarquee from '../components/TechMarquee.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const buttons = [
  { href: site.github, label: 'GitHub' },
  { href: site.linkedin, label: 'LinkedIn' },
  { href: site.cv, label: 'CV ↓',download: 'CV Jorge Muñoz Martínez.pdf' },
];
---
<Layout title="Jorge Muñoz | Desarrollador de software · IA y datos">
  <section id="inicio" class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-10 px-6 pt-14 pb-24">
    <div class="min-w-0 flex-[1_1_520px]">
      <p class="inline-flex items-center gap-2.5 rounded-full border border-line px-3.5 py-1.5 font-mono text-[13px] text-ink-soft">
        <span aria-hidden="true" class="size-2 rounded-full bg-accent"></span>
        IA · Datos · Desarrollo
      </p>

      <h1 class="mt-7 font-display text-[clamp(4rem,11vw,8.5rem)] leading-[0.88] font-bold tracking-[-0.05em]">
        Jorge<br />
        <span class="text-outline">Muñoz</span>
      </h1>

      <p class="mt-8 max-w-[520px] text-[19px] text-ink-soft">
        Del código al modelo. Técnico en DAM,{' '}
        <strong class="font-semibold text-ink">Máster en IA y Big Data</strong>{' '}
        y cursando DAW, desde Jaén.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#proyectos"
          class="inline-flex min-h-13 items-center gap-2.5 rounded-full bg-accent px-6 font-semibold text-bg transition-transform hover:scale-105"
        >
          Ver proyectos ↗
        </a>
        {buttons.map((button) => (
          <a
            href={button.href}
            class="inline-flex min-h-13 items-center rounded-full border border-line-strong px-5.5 transition-colors hover:border-accent hover:text-accent"
          >
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <SkillGraph />
  </section>

  <TechMarquee />
  <Projects />
  <Experience />
  <Education />
  <About />
  <Contact />
</Layout>